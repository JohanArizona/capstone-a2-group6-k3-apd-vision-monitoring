# ====================================================
# Docker Compose Environment Variables
# Copy this file to .env and fill in the actual values
# ====================================================

# ====================================================
# DATABASE CONFIGURATION
# ====================================================
DB_USER=capstone_user
DB_PASSWORD=your_secure_password_here_change_this
DB_NAME=capstone_db

# ====================================================
# FASTAPI/BACKEND CONFIGURATION
# ====================================================
# JWT Secret Key - IMPORTANT: Use a strong random string in production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-jwt-key-change-this-in-production-generate-random-string

# ====================================================
# TELEGRAM BOT CONFIGURATION
# ====================================================
# 1. Create bot: Talk to @BotFather on Telegram
# 2. Copy the token from BotFather: XXX:YYY format
# 3. Get Chat ID: Add bot to group, send message, check logs at: https://api.telegram.org/botTOKEN/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ====================================================
# PYTHON/APPLICATION
# ====================================================
PYTHONUNBUFFERED=1
