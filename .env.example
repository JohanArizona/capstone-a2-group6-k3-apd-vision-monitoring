# PPE Detection API - Environment Variables
# ==========================================
# Copy this file to .env and modify as needed

# Model Configuration
PPE_MODEL_PATH=models/ppe_model.pt
PPE_CONFIDENCE=0.5

# Server Configuration
PORT=5000
FLASK_DEBUG=false

# Roboflow API Key (for dataset download)
# Get from: https://app.roboflow.com/settings/api
# ROBOFLOW_API_KEY=your_api_key_here

# Kaggle Credentials (for dataset download)
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_key
